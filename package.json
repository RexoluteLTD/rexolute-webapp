{
  "name": "rexolute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=@rexolute/landing",
    "dev:admin": "turbo run dev --filter=@rexolute/admin",
    "dev:client": "turbo run dev --filter=@rexolute/client",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck:check",
    "lint": "turbo run lint:check",
    "test": "turbo run test:check",
    "preview:landing": "turbo run preview --filter=@rexolute/landing",
    "preview:admin": "turbo run preview --filter=@rexolute/admin",
    "preview:client": "turbo run preview --filter=@rexolute/client",
    "build:landing": "turbo run build --filter=@rexolute/landing",
    "build:admin": "turbo run build --filter=@rexolute/admin",
    "build:client": "turbo run build --filter=@rexolute/client",
    "lint:check": "eslint apps packages scripts *.ts *.mjs",
    "typecheck:check": "tsc --noEmit && tsc --noEmit -p apps/landing && tsc --noEmit -p apps/admin && tsc --noEmit -p apps/client",
    "test:check": "node --test scripts/*.test.mjs && vitest run",
    "routes:generate": "turbo run routes:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "turbo": "^2.8.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tanstack/react-router": "^1.139.0",
    "@tanstack/router-plugin": "^1.139.0",
    "@tanstack/router-generator": "^1.139.0"
  }
}
