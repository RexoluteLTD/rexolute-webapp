# Full, public API endpoint for the local Vite dev server.
VITE_LOCAL_API_URL=https://api-dev.rexolute.co/v1/
# Optional same-origin proxy for dev/preview. Leave VITE_LOCAL_API_URL empty in dev to use it.
# API_PROXY_TARGET=http://localhost:8080
# App origins for links between independently hosted apps.
VITE_LANDING_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_CLIENT_URL=http://localhost:5175

# Public Cloudinary cloud name and restricted unsigned preset for article images.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_ARTICLE_PRESET=
