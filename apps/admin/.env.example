# Local Vite proxy target only; browsers always call /api/v1/ on the app origin.
# Remove this when using local Traefik. The /api/v1/ path is preserved.
API_PROXY_TARGET=http://localhost:8080
# App origins for links between independently hosted apps.
VITE_LANDING_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_CLIENT_URL=http://localhost:5175
